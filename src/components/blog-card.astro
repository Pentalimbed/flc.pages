---
import "@styles/global.css";

interface Props {
  title: string;
  url: string;

  italic: string;
  align: string;
  weight: string;
}

const { title, url, italic, align, weight } = Astro.props;
---

<a href={url} class="w-fit">
  <div
    class="border border-whitish w-fit max-w-sm p-[0.25em] font-mono text-3xl"
    ,
    style={{ fontStyle: italic, textAlign: align, "--rnd-weight": weight }}
  >
    {title}
  </div>
</a>

<style>
  a div {
    font-weight: var(--rnd-weight);
  }
  a div:hover {
    color: var(--color-blackish);
    background-color: var(--color-whitish);
    font-weight: 900;
    transition:
      color 0.2s ease-out,
      background-color 0.2s ease-out,
      font-weight 0.2s ease-out;
  }
</style>
