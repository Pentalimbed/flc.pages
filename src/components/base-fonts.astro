---
import { Font } from "astro:assets";
import FontLoader from "./font-loader.astro";
---

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link rel="preconnect" href="https://fontsapi.zeoseven.com/">

<Font cssVariable="--font-suse-mono" />
<Font cssVariable="--font-newsreader" />
<Font cssVariable="--font-playfair" />

<FontLoader url="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@100..900&display=swap"/>
<!-- 文源宋体 WenYuan Serif SC VF -->
<FontLoader url="https://fontsapi.zeoseven.com/415/main/result.css"/>
<!-- 文鼎PL UKai AR PL UKai CN -->
<FontLoader url="https://fontsapi.zeoseven.com/577/main/result.css"/>