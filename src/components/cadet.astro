---
import "@styles/global.css";
---

<span class="blink inline-block align-bottom w-[1ch] h-[1lh] bg-current"></span>
<style>
    .blink {
        animation: blink-animation 1s steps(1, start) infinite;
    }
    @keyframes blink-animation {
        50% {
            visibility: hidden;
        }
    }
</style>
