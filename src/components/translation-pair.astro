---
interface Props {
  originalLang?: string;
  translationLang?: string;
}

const {
  originalLang = "en",
  translationLang = "zh-CN",
} = Astro.props;
---

<div class="flex flex-wrap">
  <div
    lang={originalLang}
    class="post-content grow basis-2xl border border-dimmed border-dashed p-[2ch] m-3"
  >
    <slot name="original" />
  </div>
  <div
    lang={translationLang}
    class="post-content grow basis-2xl border border-whitish p-[2ch] m-3"
  >
    <slot name="translation" />
  </div>
</div>
