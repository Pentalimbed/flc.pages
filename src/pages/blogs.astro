---
import Layout from "@layouts/layout.astro";

import Caret from "@components/caret.html";
import LinkStack from "@components/link-stack.astro";

const blogFiles = Object.values(
  import.meta.glob("./blogs/*.{astro,md,mdx}", { eager: true }),
);
const blogs = blogFiles
  .map((file) => {
    // Derive URL path from file URL, e.g. /blogs/my-post
    const url =
      file.url ??
      file.file.replace(/.*\/pages/, "").replace(/\.(astro|md|mdx)$/, "");

    // Pull title from frontmatter (md/mdx) or a named export (astro)
    const title =
      file.frontmatter?.title ??
      file.title ??
      url.split("/").pop()?.replace(/-/g, " ") ??
      "Untitled";

    const date = file.frontmatter?.date ?? file.frontmatter?.pubDate ?? null;

    return { url, title, date };
  })
  .sort((a, b) => {
    // Sort newest first if dates available, otherwise alphabetically
    if (a.date && b.date)
      return new Date(b.date).getTime() - new Date(a.date).getTime();
    return a.title.localeCompare(b.title);
  });
---

<Layout title="Blogs">
  <div class="flex flex-col font-mono h-full">
    <nav class="mx-[0.5rem] py-[0.5rem] border-b flex">
      <a href="/" class="italic">&lt; index <Caret /></a>
      <div class="grow"></div>
      <div class="flex h-full gap-[0.3dvh]">
        <LinkStack />
      </div>
    </nav>
    <nav
      id="card-board"
      class="flex flex-col md:flex-wrap md:content-start md:h-full w-full overflow-y-auto md:overflow-x-auto p-10 gap-[1em]"
    >
      {
        blogs.map((blog) => (
          <a href={blog.url}>
            <div class="blog-card border border-whitish w-full max-w-sm p-[0.25em] font-mono text-3xl wrap-break-word">
              {blog.title}
            </div>
          </a>
        ))
      }
    </nav>
  </div>
</Layout>

<script>
  function randomizeStyles() {
    document.querySelectorAll(".blog-card").forEach((card) => {
      const italic = Math.random() < 0.7 ? "normal" : "italic";
      const rnd_align = Math.random();
      const align =
        rnd_align < 0.7
          ? rnd_align < 0.5
            ? rnd_align < 0.3
              ? "start"
              : "justify"
            : "center"
          : "end";
      const weight = Math.random() * 500;

      if (card instanceof HTMLElement) {
        card.style.setProperty('--card-font-style', italic);
        card.style.setProperty('--card-text-align', align);
        card.style.setProperty('--card-font-weight', weight.toString());
      }
    });
  }

  document.addEventListener("DOMContentLoaded", randomizeStyles);
</script>

<style>
  html,
  body {
    overflow: hidden;
  }

  body {
    width: 100vw;
    height: 100vh;
  }

  .blog-card {
    font-weight: var(--card-font-weight);
    font-style: var(--card-font-style);
    text-align: var(--card-text-align);
    transition:
      color 0.2s ease-out,
      background-color 0.2s ease-out,
      font-weight 0.2s ease-out;
  }
  .blog-card:hover {
    color: var(--color-blackish);
    background-color: var(--color-whitish);
    font-weight: 900;
  }
</style>
