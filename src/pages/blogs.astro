---
import Layout from "@layouts/layout.astro";

import Caret from "@components/caret.astro";
import BlogCard from "@components/blog-card.astro";

const blogFiles = Object.values(
  import.meta.glob("./blogs/*.{astro,md,mdx}", { eager: true }),
);
const blogs = blogFiles
  .map((file) => {
    // Derive URL path from file URL, e.g. /blogs/my-post
    const url =
      file.url ??
      file.file.replace(/.*\/pages/, "").replace(/\.(astro|md|mdx)$/, "");

    // Pull title from frontmatter (md/mdx) or a named export (astro)
    const title =
      file.frontmatter?.title ??
      file.title ??
      url.split("/").pop()?.replace(/-/g, " ") ??
      "Untitled";

    const date = file.frontmatter?.date ?? file.frontmatter?.pubDate ?? null;

    const italic = Math.random() < 0.7 ? "normal" : "italic";
    const rnd_align = Math.random();
    const align =
      rnd_align < 0.7
        ? rnd_align < 0.5
          ? rnd_align < 0.3
            ? "start"
            : "justify"
          : "center"
        : "end";
    const weight = Math.random() * 500;

    return { url, title, date, italic, align, weight };
  })
  .sort((a, b) => {
    // Sort newest first if dates available, otherwise alphabetically
    if (a.date && b.date)
      return new Date(b.date).getTime() - new Date(a.date).getTime();
    return a.title.localeCompare(b.title);
  });
---

<link
  href="https://fonts.googleapis.com/css2?family=SUSE+Mono:ital,wght@0,100..800;1,100..800&display=swap"
  rel="stylesheet"
/>

<Layout title="Blogs">
  <div class="flex flex-col font-mono h-screen">
    <nav class="mx-[0.5rem] py-[0.5rem] border-b">
      <a href="/" class="italic">&lt; index <Caret /></a>
    </nav>
    <nav
      id="card-board"
      class="flex flex-col flex-wrap content-start h-full w-full overflow-x-auto p-10 gap-[1em]"
    >
      {
        blogs.map((blog) => (
          <BlogCard
            title={blog.title}
            url={blog.url}
            italic={blog.italic}
            align={blog.align}
            weight={blog.weight.toString()}
          />
        ))
      }
    </nav>
  </div>
</Layout>

<style>
  body {
    overflow-y: hidden;
  }
</style>
