    <div class="flex flex-col">
      <nav class="py-[0.5rem] border-b text-whitish mbe-3">
        <a href="/" class="italic">&lt; index <Caret /></a>
      </nav>
      <p class="text-6xl">ERROR 404</p>
    </div>
  </div>
</Layout>

<style>
  body {
    width: 100vw;
    height: 100vh;
  }
</style>
